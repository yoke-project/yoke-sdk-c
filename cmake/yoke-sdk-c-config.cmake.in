# The C family, for find_package(yoke-sdk-c): the target yoke::yoke-c and what it links against.
@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(PkgConfig)
pkg_check_modules(GRPC REQUIRED IMPORTED_TARGET grpc)
pkg_check_modules(PROTOBUF_C REQUIRED IMPORTED_TARGET libprotobuf-c)
find_dependency(Threads)
find_dependency(OpenSSL)
include("${CMAKE_CURRENT_LIST_DIR}/yoke-sdk-c-targets.cmake")
check_required_components(yoke-sdk-c)
